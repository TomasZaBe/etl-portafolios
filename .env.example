# Copiar este archivo como .env y completar los valores.
# Todas las variables son opcionales en desarrollo local; en producción
# DJANGO_SECRET_KEY, DJANGO_DEBUG y DJANGO_ALLOWED_HOSTS deben definirse.

# Clave secreta de Django.
DJANGO_SECRET_KEY=

# True o False. Por defecto True.
DJANGO_DEBUG=

# Hosts permitidos separados por comas, por ejemplo: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=
